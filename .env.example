# Database (Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/sports_tech_intel"
DIRECT_URL="postgresql://user:password@localhost:5432/sports_tech_intel"

# AI Configuration (OpenAI compatible)
AI_API_KEY="your-api-key"
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4.1-mini"

# Website
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Clerk Authentication (optional)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# Stripe Pro subscription
# Legacy provider; use BILLING_PROVIDER=stripe only for an existing Stripe account.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."

# Paddle Billing (selected provider). Separate sandbox and production credentials.
BILLING_PROVIDER="paddle"
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY=""
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
PADDLE_PRO_PRICE_ID=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_CHECKOUT_ENABLED="false"

# Admin
ADMIN_EMAILS="you@example.com"

# Cron
CRON_SECRET="replace-me"

# PostHog ingestion (project token is public, personal key is NOT)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Use https://eu.i.posthog.com for an EU project
POSTHOG_PROJECT_ID=""
POSTHOG_PERSONAL_API_KEY=""

# Optional read-only deployment report in /admin/system
VERCEL_READ_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
